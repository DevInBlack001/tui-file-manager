# Rust build artifacts
/target/
# Cargo.lock is committed deliberately: fim is a binary, and the AUR
# PKGBUILD's `cargo fetch --locked` / `cargo build --frozen` need it present
# in the release tarball for a reproducible build.

# Config overrides (user-local, never committed)
config.local.toml

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db

# Preview temp files (written to $XDG_RUNTIME_DIR at runtime, but guard any stray local ones)
*.thumb.png
*.preview.tmp

# Shell completion build output (generated by install.sh, not source)
completions/

# Coverage / profiling
*.profdata
*.profraw
lcov.info

# Benchmark artifacts
criterion/
